{
	"name": "matthias.harzer.dev",
	"version": "1.0.0",
	"devDependencies": {
		"@biomejs/biome": "2.4.11",
		"@lit/localize": "0.12.2",
		"@lit/localize-tools": "0.8.1",
		"@lit/task": "1.0.3",
		"esbuild": "0.28.0",
		"lit": "3.3.2",
		"typescript": "6.0.3"
	},
	"scripts": {
		"analyze": "biome check --error-on-warnings",
		"format": "biome check --write",
		"build": "esbuild --bundle --outdir=public/dist --keep-names src/index.ts",
		"typecheck": "tsc --noEmit",
		"watch": "esbuild --bundle --outdir=public/dist --keep-names --sourcemap --watch src/index.ts"
	}
}
